        <!-- Actor -->
        <mxCell id="actor" value="Khách Mua Hàng&#xa;(Guest / User)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#d70018;strokeColor=#991b1b;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="320" width="50" height="100" as="geometry" />
