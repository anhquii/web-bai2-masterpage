  <!-- TAB 1: USE CASE DIAGRAM -->
  <diagram id="use-case-b3" name="1. Sơ Đồ Use Case (Giỏ Hàng &amp; Thanh Toán)">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sys" value="HỆ THỐNG GIỎ HÀNG &amp; THANH TOÁN (MYPHONESHOP - PHASE B3)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#0f172a;fontStyle=1;fontSize=14;startSize=35;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="760" height="680" as="geometry" />
        </mxCell>
        <mxCell id="uc1" value="UC01: Xem chi tiết SP &amp; Chọn số lượng [-][1][+]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontStyle=1;" vertex="1" parent="sys">
          <mxGeometry x="70" y="60" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc2" value="UC02: Thêm vào giỏ hàng (Session[&#39;Cart&#39;] + Toast)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#d70018;fontStyle=1;" vertex="1" parent="sys">
          <mxGeometry x="70" y="155" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc3" value="UC03: Mua ngay (Thêm giỏ + Chuyển thẳng Checkout)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#d70018;fontStyle=1;" vertex="1" parent="sys">
          <mxGeometry x="70" y="250" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="UC04: Quản lý Giỏ hàng (Tăng/Giảm/Xóa AJAX UpdatePanel)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontStyle=1;" vertex="1" parent="sys">
          <mxGeometry x="70" y="350" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="UC05: Thêm SP gợi ý (Có thể bạn cũng thích)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#16a34a;fontStyle=1;" vertex="1" parent="sys">
          <mxGeometry x="70" y="450" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc6" value="UC06: Đặt hàng &amp; Xuất hóa đơn #MPS{OrderId}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;" vertex="1" parent="sys">
          <mxGeometry x="70" y="555" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="UC06.1: Thanh toán COD&#xa;(Ship 30k nếu &lt; 5tr, 0đ nếu &gt;= 5tr)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#475569;" vertex="1" parent="sys">
          <mxGeometry x="450" y="490" width="250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="uc8" value="UC06.2: Chuyển khoản VietQR MB Bank&#xa;(Freeship 0đ + Sinh QR động Napas247)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0284c7;" vertex="1" parent="sys">
          <mxGeometry x="450" y="585" width="250" height="65" as="geometry" />
